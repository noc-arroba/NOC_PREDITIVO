{
  "version": 2,
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/bgp", "dest": "/api/bgp.js" },
    { "src": "/api/olts-ixc", "dest": "/api/olts-ixc.js" },
    { "src": "/api/test-vpn", "dest": "/api/test-vpn.js" },
    { "src": "/api/test-snmp", "dest": "/api/test-snmp.js" },
    { "src": "/api/security", "dest": "/api/security.js" },
    { "src": "/mtr.json", "dest": "/public/mtr.json" },
    { "src": "/config.html", "dest": "/public/config.html" },
    { "src": "/security.html", "dest": "/public/security.html" },
    { "src": "/index.html", "dest": "/public/index.html" },
    { "src": "/", "dest": "/public/index.html" }
  ]
}
