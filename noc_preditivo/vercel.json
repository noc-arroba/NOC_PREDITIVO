{
  "version": 2,
  "builds": [
    { "src": "api/bgp.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/bgp", "dest": "/api/bgp.js" },
    { "src": "/mtr.json", "dest": "/public/mtr.json" },
    { "src": "/(.*)", "dest": "/public/$1" },
    { "src": "/", "dest": "/public/index.html" }
  ]
}
